# Elige tu proveedor: openai, deepseek, ollama, vllm, gemini
LLM_PROVIDER=ollama

# Modelo a utilizar (asegúrate de que el nombre sea el correcto para tu proveedor)
# Ejemplos: gpt-4o-mini (openai), deepseek-chat (deepseek), llama3 (ollama)
MODELO=llama3.1:latest

# Claves de API (Solo necesitas rellenar la del proveedor que hayas elegido arriba)
OPENAI_API_KEY=ollama
DEEPSEEK_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# Si usas vLLM en otro puerto/servidor, descomenta y configura esta línea:
# VLLM_BASE_URL=http://localhost:8000/v1